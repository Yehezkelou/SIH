# Toutes les requêtes passent par l'API Gateway, jamais directement par le
# microservice : c'est elle qui porte l'authentification et le contrôle d'accès.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Portail d'authentification partagé (frontend auth-service)
NEXT_PUBLIC_AUTH_URL=http://localhost:3000/login
